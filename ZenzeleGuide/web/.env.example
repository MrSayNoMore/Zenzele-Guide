# Copy this file to ".env" and fill in your own values. Never commit ".env".

# create.xyz / Anything project token (from your project settings)
ANYTHING_PROJECT_TOKEN=

# Supabase Postgres connection — use the "Session pooler" connection string.
# Used for local dev. On Cloudflare Workers this is provided by the HYPERDRIVE
# binding instead of this variable.
DATABASE_URL=
