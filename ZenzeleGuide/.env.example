# Copy to .env for local development. Never commit real values.
#
# On Cloudflare (Workers & Pages → zenzele-guide → Settings):
#   - Build variables:   VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY
#   - Runtime variables: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY
#   - Runtime SECRET:    SUPABASE_SERVICE_ROLE_KEY  (encrypt it; server only)

# Browser (baked in at build time; publishable key is safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server (read at runtime by the Worker)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
