# Copy to .env for local development. Never commit real values.
#
# On Cloudflare (Workers & Pages → zenzele-guide → Settings):
#   - Build variables:   VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY
#   - Runtime variables: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY
#   - Runtime SECRET:    SUPABASE_SERVICE_ROLE_KEY  (encrypt it; server only)

# Browser (baked in at build time; publishable key is safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server (read at runtime by the Worker)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI import (admin). Runtime SECRETS in Cloudflare; never commit real keys.
# Gemini is used when GEMINI_API_KEY is set (it reads PDF pages directly);
# otherwise Groq (text only). AI_PROVIDER=gemini|groq forces one.
GEMINI_API_KEY=
# Gemini models to use, in order; when one hits its free limit the next is used,
# and the double-check prefers a different model. Default:
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_PROVIDER=
