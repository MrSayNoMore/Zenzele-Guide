# Copy this file to ".env" and fill in your Supabase project values.
# Never commit ".env" (it is git-ignored).
#
# VITE_* values are embedded in the browser bundle — use ONLY publishable
# (anon) values here, never the service-role secret. The non-VITE_ duplicates
# are read server-side (SSR) as a fallback.
#
# On Cloudflare, set these as the Worker's environment variables / build vars.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
